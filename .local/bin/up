#!/bin/bash
### Update everything


#set -e

if [[ -x $(command -v apt) ]]; then
    banner apt
    sudo apt update
    sudo apt --yes full-upgrade
else
    echo "Skipping apt update"
fi

if [[ -x $(command -v flatpak) ]]; then
    banner flatpak
    flatpak uninstall --unused --assumeyes
    flatpak --assumeyes update
else
    echo "Skipping flatpak update"
fi

if [[ -x $(command -v rustup) ]]; then
    banner cargo
    rustup update
    # cargo install cargo-update
    cargo install-update --all
else
    echo "Skipping rust update"
fi

if [[ -x $(command -v pipx) ]]; then
    banner pipx
    echo Installed: $(pipx list | grep package | awk '{print $2}')
    pipx upgrade-all
else
    echo "Skipping pipx update"
fi

if [[ -x $(command -v uv) ]]; then
    banner uv
    echo Installed: $(uv tool list | grep --invert-match '^-' | awk '{print $1}')
    uv tool upgrade --all
else
    echo "Skipping uv tool update"
fi

if [[ -x $(command -v npm-check) ]]; then
    banner npm
    npm-check --global --update-all
else
    echo "Skipping npm update"
fi

if [[ -x $(command -v toolbox) ]]; then
    banner toolbox
    image=ghcr.io/joehalliwell/toolbox:latest
    name=toolbox

    podman pull "$image"

    # A container is pinned to the image ID it was created from; pulling a
    # newer :latest changes nothing until the container is recreated.
    want=$(podman image inspect "$image" --format '{{.Id}}')
    have=$(podman container inspect "$name" --format '{{.Image}}' 2>/dev/null)
    open=$(podman container inspect "$name" --format '{{len .ExecIDs}}' 2>/dev/null || echo 0)

    if [[ "$want" == "$have" ]]; then
        echo "toolbox current (${want:0:12})"
    elif (( open > 0 )); then
        echo "toolbox stale (${have:0:12} -> ${want:0:12}), $open session(s) open; skipping"
    else
        echo "toolbox stale (${have:0:12} -> ${want:0:12}); recreating"
        podman container exists "$name" && toolbox rm --force "$name"
        toolbox create --image "$image" "$name"
    fi

    podman image prune --force --external
fi
