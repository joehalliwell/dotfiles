#!/bin/bash
### Update everything


#set -e

if [[ -x $(command -v apt) ]]; then
    banner apt
    sudo apt update
    sudo apt --yes full-upgrade
else
    echo "Skipping apt update"
fi

if [[ -x $(command -v flatpak) ]]; then
    banner flatpak
    flatpak uninstall --unused --assumeyes
    flatpak --assumeyes update
else
    echo "Skipping flatpak update"
fi

if [[ -x $(command -v rustup) ]]; then
    banner cargo
    rustup update
    # cargo install cargo-update
    cargo install-update --all
else
    echo "Skipping rust update"
fi

if [[ -x $(command -v pipx) ]]; then
    banner pipx
    echo Installed: $(pipx list | grep package | awk '{print $2}')
    pipx upgrade-all
else
    echo "Skipping pipx update"
fi

if [[ -x $(command -v uv) ]]; then
    banner uv
    echo Installed: $(uv tool list | grep --invert-match '^-' | awk '{print $1}')
    uv tool upgrade --all
else
    echo "Skipping uv tool update"
fi

if [[ -x $(command -v npm-check) ]]; then
    banner npm
    npm-check --global --update-all
else
    echo "Skipping npm update"
fi


if [[ -x $(command -v pacman) ]]; then
    banner pacman
    sudo pacman -Syu --noconfirm
fi

if [[ -x $(command -v yay) ]]; then
    banner yay
    yay -Syu --noconfirm
fi

if [[ "" && -x $(command -v toolbox) ]]; then
    banner toolbox
    image=ghcr.io/joehalliwell/toolbox:latest
    name=toolbox

    podman image prune --force --external
    podman pull "$image"

    # The latest container is probably in use -- running this script, so
    # so do a little dance to swap the name over
    podman container exists tmp && podman container rm tmp
    podman container exists "$name" && podman rename "$name" tmp
    toolbox create --image "$image" "$name"
fi
